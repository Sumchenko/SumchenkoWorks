<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Booking"
                  targetNamespace="https://sapigateam.example/bpmn/clinic-booking">

  <bpmn:collaboration id="Collaboration_Booking">
    <bpmn:participant id="Participant_Booking" name="Запись пациента на приём (С-01, С-05)" processRef="Process_Booking" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Booking" name="Запись пациента на приём" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Booking">
      <bpmn:lane id="Lane_Patient" name="Пациент">
        <bpmn:flowNodeRef>Start_Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pick</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Assistant" name="Голосовой ассистент (автомат)">
        <bpmn:flowNodeRef>Task_Greet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RedFlag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Emergency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Emergency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Understand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Intent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Other</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_R07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Active</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rescheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Waitlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Waitlisted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Booked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmSay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Booked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="Бэкенд и МИС">
        <bpmn:flowNodeRef>Task_SearchSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Book</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Call" name="Входящий звонок">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Request" name="Озвучивает запрос">
      <bpmn:incoming>Flow_01b</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Greet" name="Приветствие, согласие на запись (3.3, 3.4)">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_01b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_RedFlag" name="Красные флаги (код, до LLM)">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Emergency" name="103/112 и немедленный перевод (R-01)">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Emergency" name="Экстренный звонок">
      <bpmn:incoming>Flow_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Understand" name="LLM: понять реплику (function calling шага)">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Intent" name="Запись на приём?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Other" name="Справка, вызов на дом, анализы…">
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Identity" name="Называет ФИО и дату рождения">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Identify" name="Идентификация пациента (patients/identify)">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Found" name="Пациент найден?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_R07" name="Прикрепление (С-13) или перевод (R-07)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Transfer" name="Перевод сотруднику">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Active" name="Уже есть запись к специальности?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rescheduled" name="Перенос записи (С-03)">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_SearchSlots" name="Поиск свободных слотов (slots/search)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Offer" name="Называет свободные слоты">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Waitlist" name="Лист ожидания (С-11), SMS">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Waitlisted" name="Поставлен в лист ожидания">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Pick" name="Выбирает день и время">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Book" name="Резерв слота + создание записи в МИС (visits)">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Booked" name="201 от МИС?">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Fail" name="Понятная фраза, R-06">
      <bpmn:incoming>Flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ConfirmSay" name="«Вы записаны»: дата, кабинет; SMS ушла">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Booked" name="Запись создана">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Call" targetRef="Task_Greet" />
    <bpmn:sequenceFlow id="Flow_01b" sourceRef="Task_Greet" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Request" targetRef="GW_RedFlag" />
    <bpmn:sequenceFlow id="Flow_03" name="красный флаг" sourceRef="GW_RedFlag" targetRef="Task_Emergency" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Emergency" targetRef="End_Emergency" />
    <bpmn:sequenceFlow id="Flow_05" name="нет" sourceRef="GW_RedFlag" targetRef="Task_Understand" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Understand" targetRef="GW_Intent" />
    <bpmn:sequenceFlow id="Flow_07" name="другой сценарий" sourceRef="GW_Intent" targetRef="End_Other" />
    <bpmn:sequenceFlow id="Flow_08" name="запись" sourceRef="GW_Intent" targetRef="Task_Identity" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Identity" targetRef="Task_Identify" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Identify" targetRef="GW_Found" />
    <bpmn:sequenceFlow id="Flow_11" name="не найден" sourceRef="GW_Found" targetRef="Task_R07" />
    <bpmn:sequenceFlow id="Flow_12" name="найден" sourceRef="GW_Found" targetRef="GW_Active" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_R07" targetRef="End_Transfer" />
    <bpmn:sequenceFlow id="Flow_14" name="есть (С-03)" sourceRef="GW_Active" targetRef="End_Rescheduled" />
    <bpmn:sequenceFlow id="Flow_15" name="нет" sourceRef="GW_Active" targetRef="Task_SearchSlots" />
    <bpmn:sequenceFlow id="Flow_16" name="время есть" sourceRef="Task_SearchSlots" targetRef="Task_Offer" />
    <bpmn:sequenceFlow id="Flow_17" name="времени нет" sourceRef="Task_SearchSlots" targetRef="Task_Waitlist" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Offer" targetRef="Task_Pick" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Waitlist" targetRef="End_Waitlisted" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Pick" targetRef="Task_Book" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Book" targetRef="GW_Booked" />
    <bpmn:sequenceFlow id="Flow_22" name="нет (503, 409)" sourceRef="GW_Booked" targetRef="End_Fail" />
    <bpmn:sequenceFlow id="Flow_23" name="да" sourceRef="GW_Booked" targetRef="Task_ConfirmSay" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_ConfirmSay" targetRef="End_Booked" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Booking">
    <bpmndi:BPMNPlane id="Plane_Booking" bpmnElement="Collaboration_Booking">
      <bpmndi:BPMNShape id="Participant_Booking_di" bpmnElement="Participant_Booking" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1800" height="760" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Patient_di" bpmnElement="Lane_Patient" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1770" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Assistant_di" bpmnElement="Lane_Assistant" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="1770" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Backend_di" bpmnElement="Lane_Backend" isHorizontal="true">
        <dc:Bounds x="190" y="600" width="1770" height="240" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Call_di" bpmnElement="Start_Call">
        <dc:Bounds x="240" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="216" y="175" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Request_di" bpmnElement="Task_Request">
        <dc:Bounds x="330" y="110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Greet_di" bpmnElement="Task_Greet">
        <dc:Bounds x="330" y="410" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_RedFlag_di" bpmnElement="GW_RedFlag" isMarkerVisible="true">
        <dc:Bounds x="490" y="425" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="445" y="482" width="140" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Emergency_di" bpmnElement="Task_Emergency">
        <dc:Bounds x="590" y="250" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Emergency_di" bpmnElement="End_Emergency">
        <dc:Bounds x="740" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="700" y="315" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Understand_di" bpmnElement="Task_Understand">
        <dc:Bounds x="590" y="410" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Intent_di" bpmnElement="GW_Intent" isMarkerVisible="true">
        <dc:Bounds x="750" y="425" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="725" y="482" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Other_di" bpmnElement="End_Other">
        <dc:Bounds x="800" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="748" y="232" width="140" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Identity_di" bpmnElement="Task_Identity">
        <dc:Bounds x="870" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Identify_di" bpmnElement="Task_Identify">
        <dc:Bounds x="870" y="410" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Found_di" bpmnElement="GW_Found" isMarkerVisible="true">
        <dc:Bounds x="1030" y="425" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1005" y="482" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_R07_di" bpmnElement="Task_R07">
        <dc:Bounds x="870" y="250" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Transfer_di" bpmnElement="End_Transfer">
        <dc:Bounds x="1030" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="995" y="315" width="106" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Active_di" bpmnElement="GW_Active" isMarkerVisible="true">
        <dc:Bounds x="1120" y="425" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1085" y="482" width="120" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rescheduled_di" bpmnElement="End_Rescheduled">
        <dc:Bounds x="1122" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1060" y="585" width="160" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SearchSlots_di" bpmnElement="Task_SearchSlots">
        <dc:Bounds x="1090" y="650" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Offer_di" bpmnElement="Task_Offer">
        <dc:Bounds x="1250" y="410" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Waitlist_di" bpmnElement="Task_Waitlist">
        <dc:Bounds x="1170" y="250" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Waitlisted_di" bpmnElement="End_Waitlisted">
        <dc:Bounds x="1340" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1300" y="315" width="116" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Pick_di" bpmnElement="Task_Pick">
        <dc:Bounds x="1330" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Book_di" bpmnElement="Task_Book">
        <dc:Bounds x="1410" y="650" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Booked_di" bpmnElement="GW_Booked" isMarkerVisible="true">
        <dc:Bounds x="1410" y="425" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1395" y="482" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Fail_di" bpmnElement="End_Fail">
        <dc:Bounds x="1410" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1352" y="585" width="152" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmSay_di" bpmnElement="Task_ConfirmSay">
        <dc:Bounds x="1500" y="410" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Booked_di" bpmnElement="End_Booked">
        <dc:Bounds x="1680" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1652" y="475" width="92" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="258" y="168" />
        <di:waypoint x="258" y="450" />
        <di:waypoint x="330" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_01b_di" bpmnElement="Flow_01b">
        <di:waypoint x="390" y="410" />
        <di:waypoint x="390" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="450" y="150" />
        <di:waypoint x="470" y="150" />
        <di:waypoint x="470" y="450" />
        <di:waypoint x="490" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="515" y="425" />
        <di:waypoint x="515" y="290" />
        <di:waypoint x="590" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="710" y="290" />
        <di:waypoint x="740" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="540" y="450" />
        <di:waypoint x="590" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="710" y="450" />
        <di:waypoint x="750" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="775" y="425" />
        <di:waypoint x="775" y="308" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="800" y="450" />
        <di:waypoint x="870" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="930" y="190" />
        <di:waypoint x="930" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="990" y="450" />
        <di:waypoint x="1030" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1055" y="425" />
        <di:waypoint x="1055" y="290" />
        <di:waypoint x="990" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1080" y="450" />
        <di:waypoint x="1120" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="990" y="290" />
        <di:waypoint x="1030" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1135" y="475" />
