<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Sync"
                  targetNamespace="https://mito.example/bpmn/sync">

  <bpmn:collaboration id="Collaboration_Sync">
    <bpmn:participant id="Participant_Sync" name="Синхронизация данных" processRef="Process_Sync" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Sync" name="Синхронизация данных" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Sync">
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>Start_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Edit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="Приложение">
        <bpmn:flowNodeRef>Task_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Online</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Offline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Get</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Сервер (Supabase)">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Newer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveServer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Change" name="Нужно изменить данные">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Edit" name="Изменить задачу или блок">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Save" name="Сохранить на устройстве и поставить в очередь">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Online" name="Есть интернет?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Offline" name="Изменения ждут сети">
      <bpmn:incoming>Flow_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Send" name="Отправить изменения на сервер">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Check" name="Проверить, что пользователь меняет свои данные">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Accepted" name="Запрос принят?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Error" name="Показать ошибку">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Retry" name="Повтор позже">
      <bpmn:incoming>Flow_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Newer" name="Версия новее серверной?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SaveServer" name="Сохранить новую версию">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Keep" name="Оставить серверную версию">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Get" name="Получить изменения других устройств">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Apply" name="Сохранить более новые версии">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Done" name="Данные синхронизированы">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Change" targetRef="Task_Edit" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Edit" targetRef="Task_Save" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Save" targetRef="Gateway_Online" />
    <bpmn:sequenceFlow id="Flow_04" name="Нет" sourceRef="Gateway_Online" targetRef="End_Offline" />
    <bpmn:sequenceFlow id="Flow_05" name="Да" sourceRef="Gateway_Online" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Send" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Check" targetRef="Gateway_Accepted" />
    <bpmn:sequenceFlow id="Flow_08" name="Нет" sourceRef="Gateway_Accepted" targetRef="Task_Error" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Error" targetRef="End_Retry" />
    <bpmn:sequenceFlow id="Flow_10" name="Да" sourceRef="Gateway_Accepted" targetRef="Gateway_Newer" />
    <bpmn:sequenceFlow id="Flow_11" name="Да" sourceRef="Gateway_Newer" targetRef="Task_SaveServer" />
    <bpmn:sequenceFlow id="Flow_12" name="Нет" sourceRef="Gateway_Newer" targetRef="Task_Keep" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SaveServer" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Keep" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Merge" targetRef="Task_Get" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Get" targetRef="Task_Apply" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Apply" targetRef="End_Done" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Sync">
    <bpmndi:BPMNPlane id="Plane_Sync" bpmnElement="Collaboration_Sync">
      <bpmndi:BPMNShape id="Participant_Sync_di" bpmnElement="Participant_Sync" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1500" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1470" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_App_di" bpmnElement="Lane_App" isHorizontal="true">
        <dc:Bounds x="190" y="240" width="1470" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Server_di" bpmnElement="Lane_Server" isHorizontal="true">
        <dc:Bounds x="190" y="500" width="1470" height="220" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Change_di" bpmnElement="Start_Change">
        <dc:Bounds x="232" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="208" y="185" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Edit_di" bpmnElement="Task_Edit">
        <dc:Bounds x="310" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Save_di" bpmnElement="Task_Save">
        <dc:Bounds x="310" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Online_di" bpmnElement="Gateway_Online" isMarkerVisible="true">
        <dc:Bounds x="485" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="471" y="432" width="78" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Offline_di" bpmnElement="End_Offline">
        <dc:Bounds x="492" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="536" y="283" width="70" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Send_di" bpmnElement="Task_Send">
        <dc:Bounds x="580" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Error_di" bpmnElement="Task_Error">
        <dc:Bounds x="800" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Retry_di" bpmnElement="End_Retry">
        <dc:Bounds x="842" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="886" y="283" width="74" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Get_di" bpmnElement="Task_Get">
        <dc:Bounds x="1260" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Apply_di" bpmnElement="Task_Apply">
        <dc:Bounds x="1410" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done">
        <dc:Bounds x="1572" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1548" y="425" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Check_di" bpmnElement="Task_Check">
        <dc:Bounds x="700" y="540" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Accepted_di" bpmnElement="Gateway_Accepted" isMarkerVisible="true">
        <dc:Bounds x="835" y="555" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="822" y="612" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Newer_di" bpmnElement="Gateway_Newer" isMarkerVisible="true">
        <dc:Bounds x="935" y="555" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="916" y="515" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveServer_di" bpmnElement="Task_SaveServer">
        <dc:Bounds x="1030" y="540" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Keep_di" bpmnElement="Task_Keep">
        <dc:Bounds x="1030" y="630" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="1175" y="555" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="268" y="160" />
        <di:waypoint x="310" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="370" y="200" />
        <di:waypoint x="370" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="430" y="400" />
        <di:waypoint x="485" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="510" y="375" />
        <di:waypoint x="510" y="308" />
        <bpmndi:BPMNLabel><dc:Bounds x="516" y="333" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="535" y="400" />
        <di:waypoint x="580" y="400" />
        <bpmndi:BPMNLabel><dc:Bounds x="549" y="382" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="640" y="440" />
        <di:waypoint x="640" y="580" />
        <di:waypoint x="700" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="820" y="580" />
        <di:waypoint x="835" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="860" y="555" />
        <di:waypoint x="860" y="440" />
        <bpmndi:BPMNLabel><dc:Bounds x="866" y="490" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="860" y="360" />
        <di:waypoint x="860" y="308" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="885" y="580" />
        <di:waypoint x="935" y="580" />
        <bpmndi:BPMNLabel><dc:Bounds x="902" y="562" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="985" y="580" />
        <di:waypoint x="1030" y="580" />
        <bpmndi:BPMNLabel><dc:Bounds x="999" y="562" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="960" y="605" />
        <di:waypoint x="960" y="670" />
        <di:waypoint x="1030" y="670" />
        <bpmndi:BPMNLabel><dc:Bounds x="968" y="648" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1150" y="580" />
        <di:waypoint x="1175" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1150" y="670" />
        <di:waypoint x="1200" y="670" />
        <di:waypoint x="1200" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="1225" y="580" />
        <di:waypoint x="1320" y="580" />
        <di:waypoint x="1320" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="1380" y="400" />
        <di:waypoint x="1410" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="1530" y="400" />
        <di:waypoint x="1572" y="400" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
