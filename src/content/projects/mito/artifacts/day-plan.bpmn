<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_DayPlan"
                  targetNamespace="https://mito.example/bpmn/ai-day-plan">

  <bpmn:collaboration id="Collaboration_DayPlan">
    <bpmn:participant id="Participant_DayPlan" name="План дня от AI-ментора" processRef="Process_DayPlan" />
  </bpmn:collaboration>

  <bpmn:process id="Process_DayPlan" name="План дня от AI-ментора" isExecutable="false">
    <bpmn:laneSet id="LaneSet_DayPlan">
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>Start_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pick</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="Приложение">
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Preview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Сервер ментора">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="AI-модель">
        <bpmn:flowNodeRef>Task_Generate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Need" name="Нужен план на день">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Ask" name="Нажать «Составить план»">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Collect" name="Собрать данные о задачах и календаре">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Check" name="Проверить запрос и лимит">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Limit" name="Лимит не превышен?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ShowError" name="Показать причину ошибки">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Error" name="План не получен">
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Request" name="Запросить AI-модель (при ошибке - следующую)">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Generate" name="Составить план">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Ответ правильный?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Preview" name="Показать план">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_Pick" name="Выбрать нужные блоки">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Add" name="Добавить блоки в календарь">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Done" name="Блоки в календаре">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Need" targetRef="Task_Ask" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Ask" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Collect" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Check" targetRef="Gateway_Limit" />
    <bpmn:sequenceFlow id="Flow_05" name="Нет" sourceRef="Gateway_Limit" targetRef="Task_ShowError" />
    <bpmn:sequenceFlow id="Flow_06" name="Да" sourceRef="Gateway_Limit" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ShowError" targetRef="End_Error" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Request" targetRef="Task_Generate" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Generate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_10" name="Нет" sourceRef="Gateway_Valid" targetRef="Task_ShowError" />
    <bpmn:sequenceFlow id="Flow_11" name="Да" sourceRef="Gateway_Valid" targetRef="Task_Preview" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Preview" targetRef="Task_Pick" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Pick" targetRef="Task_Add" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Add" targetRef="End_Done" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_DayPlan">
    <bpmndi:BPMNPlane id="Plane_DayPlan" bpmnElement="Collaboration_DayPlan">
      <bpmndi:BPMNShape id="Participant_DayPlan_di" bpmnElement="Participant_DayPlan" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1400" height="740" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1370" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_App_di" bpmnElement="Lane_App" isHorizontal="true">
        <dc:Bounds x="190" y="240" width="1370" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Server_di" bpmnElement="Lane_Server" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="1370" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AI_di" bpmnElement="Lane_AI" isHorizontal="true">
        <dc:Bounds x="190" y="660" width="1370" height="160" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Need_di" bpmnElement="Start_Need">
        <dc:Bounds x="232" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="208" y="185" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ask_di" bpmnElement="Task_Ask">
        <dc:Bounds x="310" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Pick_di" bpmnElement="Task_Pick">
        <dc:Bounds x="1120" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Collect_di" bpmnElement="Task_Collect">
        <dc:Bounds x="310" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowError_di" bpmnElement="Task_ShowError">
        <dc:Bounds x="600" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Error_di" bpmnElement="End_Error">
        <dc:Bounds x="472" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="450" y="325" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Preview_di" bpmnElement="Task_Preview">
        <dc:Bounds x="1120" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Add_di" bpmnElement="Task_Add">
        <dc:Bounds x="1290" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done">
        <dc:Bounds x="1452" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1428" y="425" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Check_di" bpmnElement="Task_Check">
        <dc:Bounds x="470" y="530" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Limit_di" bpmnElement="Gateway_Limit" isMarkerVisible="true">
        <dc:Bounds x="635" y="545" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="616" y="602" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Request_di" bpmnElement="Task_Request">
        <dc:Bounds x="730" y="530" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Valid_di" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="1035" y="545" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1090" y="598" width="96" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Generate_di" bpmnElement="Task_Generate">
        <dc:Bounds x="870" y="700" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="268" y="160" />
        <di:waypoint x="310" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="370" y="200" />
        <di:waypoint x="370" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="370" y="440" />
        <di:waypoint x="370" y="570" />
        <di:waypoint x="470" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="590" y="570" />
        <di:waypoint x="635" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="660" y="545" />
        <di:waypoint x="660" y="340" />
        <bpmndi:BPMNLabel><dc:Bounds x="666" y="490" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="685" y="570" />
        <di:waypoint x="730" y="570" />
        <bpmndi:BPMNLabel><dc:Bounds x="699" y="552" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="600" y="300" />
        <di:waypoint x="508" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="790" y="610" />
        <di:waypoint x="790" y="740" />
        <di:waypoint x="870" y="740" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="990" y="740" />
        <di:waypoint x="1060" y="740" />
        <di:waypoint x="1060" y="595" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1060" y="545" />
        <di:waypoint x="1060" y="300" />
        <di:waypoint x="720" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="1066" y="490" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1085" y="570" />
        <di:waypoint x="1180" y="570" />
        <di:waypoint x="1180" y="440" />
        <bpmndi:BPMNLabel><dc:Bounds x="1110" y="552" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1180" y="360" />
        <di:waypoint x="1180" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1240" y="160" />
        <di:waypoint x="1350" y="160" />
        <di:waypoint x="1350" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1410" y="400" />
        <di:waypoint x="1452" y="400" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
